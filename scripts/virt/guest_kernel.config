# guest_kernel.config — the kconfig fragment every kudos guest kernel is built
# from, merged onto tinyconfig by scripts/virt/build_guest.sh; each image adds
# its own fragment on top (networking, input, the syscalls its userland
# assumes). Only what a serial-console initramfs boot needs on the
# devices kudos emulates (16550 serial, x2APIC, virtio over MMIO; no ACPI/PCI/
# disk).
CONFIG_64BIT=y
CONFIG_SMP=n
# Compress the kernel image with XZ: the smallest of the in-tree codecs, worth
# the extra decompress time for a guest whose size is embedded in the kudos image.
CONFIG_KERNEL_XZ=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_X86_X2APIC=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_100=y
# The graphical path: a virtio-gpu scanout the guest renders into and kudos
# composites in the VM window. There is no PCI bus or device tree in a kudos
# guest, so the device is discovered from the command line
# (VIRTIO_MMIO_CMDLINE_DEVICES) at the address the hypervisor's layout.zig owns.
# Enabling a driver is not enough when tinyconfig has closed the menu it lives
# under: VIRTIO_MENU and VT/VT_CONSOLE are the gates for the virtio drivers and
# for FRAMEBUFFER_CONSOLE, and without them those options are silently dropped
# and the guest boots to a blank display. The build scripts assert the whole
# set survived the merge rather than trusting it.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
